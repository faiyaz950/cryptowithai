# VPS par production config. Server par copy karein:
#   cp .env.production.example .env   (aur values bharein)
# Ye file docker-compose.yml padhta hai; backend container ko bhi yahi milti hai.

# ── Site ────────────────────────────────────────────────
# Domain nahi hai to:   SITE_ADDRESS=:80   aur  PUBLIC_URL=http://187.126.116.78
# Domain hai to:        SITE_ADDRESS=example.com  aur  PUBLIC_URL=https://example.com
#   (domain ka A record pehle VPS IP par point karein — Caddy HTTPS khud le aayega)
# PUBLIC_URL badla to frontend dobara build karna hoga: docker compose up -d --build
SITE_ADDRESS=:80
PUBLIC_URL=http://187.126.116.78

# ── Database ────────────────────────────────────────────
# Banayein: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Secrets ─────────────────────────────────────────────
# Banayein: openssl rand -hex 32
DJANGO_SECRET_KEY=
# Users ki exchange API keys isse encrypt hoti hain. Ek baar set karke KABHI mat
# badlein, aur kahin safe backup rakhein.
# Banayein: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=

# ── AI providers (chat) ─────────────────────────────────
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROK_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=

# ── Trading ─────────────────────────────────────────────
# Server par trading key na rakhna hi behtar hai (users apni key laate hain).
DELTA_API_KEY=
DELTA_SECRET_KEY=
# On karne ka matlab asli paisa chalna — soch-samajh kar.
LIVE_ORDERS_ENABLED=false
LIVE_ORDER_MAX_NOTIONAL=500
LIVE_ORDER_HARD_MAX_NOTIONAL=25000
TV_WEBHOOK_PER_MINUTE=20
# VPS ka public IP — users ise exchange par API key allowlist mein daalte hain.
BYOK_EGRESS_IPS=187.126.116.78

# ── Email (OTP) ─────────────────────────────────────────
# Production mein false rakhein — true par OTP API response mein hi aa jaata hai.
EMAIL_OTP_DEBUG=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_MUKUL_REFERRAL_URL=
